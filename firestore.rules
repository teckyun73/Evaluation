rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // artifacts 경로 내의 경진대회 데이터
    match /artifacts/{appId}/public/data {
      
      // 1. 점수 데이터 (평가자 점수)
      match /scores/{presenterId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null;
      }
      
      // 2. 우수 발표자 투표 데이터
      match /excellent_presenter_selections/{userId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null;
      }
      
      // 3. 평가자 부문별 제출 상태
      match /submissions/{evaluatorId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null;
      }
      
      // 4. 투표자 및 평가자 세션
      match /voter_sessions/{sessionId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
      
      match /evaluator_sessions/{sessionId} {
        allow read: if true;
        allow create, update, delete: if true;
      }
      
      // 5. 대회 동적 설정 메타데이터 (발표자, 배점기준)
      match /config/{configId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
